{
  "component": {
    "name": "Sensing",
    "description": "Every name here is <role>_<Subject>[_<qualifier>]",
    "declarations": [
      {
        "scope": "local",
        "definition": {
          "name": "val_InletTemperature_raw",
          "description": "Unconditioned reading of the inlet sensor",
          "datatype": "uint16",
          "unit": "degC",
          "conversion": { "factor": 0.1 }
        }
      },
      {
        "scope": "local",
        "definition": {
          "name": "val_InletTemperature_flt",
          "description": "Filtered inlet temperature",
          "datatype": "int16",
          "unit": "degC",
          "conversion": { "factor": 0.1 },
          "limits": { "min": -40, "max": 150 }
        }
      },
      {
        "scope": "local",
        "definition": {
          "name": "flg_InletSensorValid",
          "description": "The inlet reading is plausible",
          "datatype": "bool",
          "init": false
        }
      },
      {
        "scope": "local",
        "definition": {
          "name": "cnt_InletSensorFaults",
          "description": "Number of implausible readings seen so far",
          "datatype": "uint16",
          "init": 0
        }
      },
      {
        "scope": "local",
        "definition": {
          "kind": "parameter",
          "name": "par_InletFilterConstant",
          "description": "Time constant of the inlet filter",
          "datatype": "uint16",
          "unit": "ms",
          "init": 100
        }
      },
      {
        "scope": "local",
        "definition": {
          "kind": "axis",
          "name": "axs_InletTemperature",
          "description": "Break points of the inlet compensation",
          "datatype": "int16",
          "unit": "degC",
          "conversion": { "factor": 0.1 },
          "size": 4,
          "input": "val_InletTemperature_flt",
          "init": [-400, 0, 400, 1200]
        }
      },
      {
        "scope": "local",
        "definition": {
          "kind": "curve",
          "name": "crv_InletCompensation",
          "description": "Correction applied over the inlet temperature",
          "datatype": "int8",
          "unit": "%",
          "conversion": { "factor": 0.5 },
          "axis": "axs_InletTemperature",
          "init": [-20, 0, 10, 24]
        }
      }
    ]
  }
}
