{
  "$schema": "../../../../schemas/ddd_component.schema.json",
  "component": {
    "name": "Controller",
    "description": "Closes the pressure loop",
    "interface": [
      {
        "scope": "input",
        "definition": {
          "name": "PressureRaw",
          "kind": "measurement",
          "description": "Manifold pressure",
          "datatype": "uint16",
          "unit": "kPa",
          "conversion": {
            "factor": 0.1
          },
          "limits": {
            "min": 0,
            "max": 400
          },
          "volatile": false
        }
      },
      {
        "scope": "input",
        "definition": {
          "name": "TemperatureRaw",
          "kind": "measurement",
          "description": "Manifold temperature",
          "datatype": "sint16",
          "unit": "degC",
          "conversion": {
            "factor": 0.1
          },
          "limits": {
            "min": -40,
            "max": 150
          },
          "volatile": false
        }
      },
      {
        "scope": "output",
        "definition": {
          "name": "ValveDuty",
          "id": "4tnm8r7mst6h",
          "kind": "measurement",
          "description": "Commanded valve duty cycle",
          "datatype": "uint8",
          "unit": "%",
          "conversion": {
            "factor": 0.5
          },
          "limits": {
            "min": 0,
            "max": 100
          },
          "volatile": false
        }
      }
    ]
  }
}
