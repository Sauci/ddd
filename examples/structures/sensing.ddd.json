{
  "$schema": "../../schemas/ddd_component.schema.json",
  "component": {
    "name": "Sensing",
    "description": "Produces the readings the structured datatypes describe",
    "interface": [
      {
        "scope": "local",
        "definition": {
          "name": "InletTemperature",
          "kind": "measurement",
          "description": "Conditioned inlet reading",
          "datatype": "uint16",
          "unit": "degC",
          "conversion": {
            "factor": 0.1,
            "offset": -40
          },
          "volatile": false
        }
      },
      {
        "scope": "output",
        "definition": {
          "name": "Inlet",
          "kind": "measurement",
          "description": "The inlet sensor as this ecu sees it",
          "typename": "Sensor_t",
          "volatile": true
        }
      },
      {
        "scope": "local",
        "definition": {
          "name": "InletCal",
          "kind": "parameter",
          "description": "What the calibration tool may change about the inlet sensor",
          "typename": "SensorCal_t",
          "volatile": true
        }
      },
      {
        "scope": "local",
        "definition": {
          "name": "SampleCount",
          "kind": "measurement",
          "description": "Readings taken since the last reset",
          "datatype": "uint32",
          "conversion": {
            "kind": "identity"
          },
          "volatile": false
        }
      }
    ]
  }
}
