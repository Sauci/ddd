{
  "$schema": "../../schemas/ddd_component.schema.json",
  "component": {
    "name": "ComponentA",
    "description": "Writes the shared value",
    "interface": [
      {
        "scope": "output",
        "definition": {
          "name": "SharedValue",
          "kind": "measurement",
          "description": "Value shared between components",
          "datatype": "sint16",
          "unit": "%",
          "conversion": { "factor": 0.5 },
          "volatile": false
        }
      },
      {
        "scope": "output",
        "definition": {
          "name": "UnusedSignal",
          "kind": "measurement",
          "datatype": "uint8",
          "volatile": false
        }
      },
      {
        "scope": "local",
        "definition": {
          "name": "Scratch",
          "kind": "measurement",
          "datatype": "uint8",
          "volatile": false
        }
      }
    ]
  }
}
