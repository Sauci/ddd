{
  "$schema": "../../schemas/ddd_component.schema.json",
  "component": {
    "name": "ComponentC",
    "description": "Reads the shared value with the wrong datatype and scaling",
    "interface": [
      {
        "scope": "input",
        "definition": {
          "name": "SharedValue",
          "kind": "measurement",
          "description": "Value shared between components",
          "datatype": "uint16",
          "conversion": {
            "kind": "identity"
          },
          "unit": "%",
          "volatile": false
        }
      },
      {
        "scope": "input",
        "definition": {
          "name": "MissingValue",
          "kind": "measurement",
          "description": "Nobody produces this one",
          "datatype": "uint8",
          "conversion": {
            "kind": "identity"
          },
          "volatile": false
        }
      },
      {
        "scope": "input",
        "definition": {
          "name": "Scratch",
          "kind": "measurement",
          "datatype": "uint8",
          "conversion": {
            "kind": "identity"
          },
          "volatile": false
        }
      }
    ]
  }
}
