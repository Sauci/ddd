{
  "$schema": "../../../schemas/ddd_component.schema.json",
  "component": {
    "name": "SensorHub",
    "description": "Produces the raw input values of the device",
    "interface": [
      {
        "scope": "output",
        "definition": {
          "name": "ValueA",
          "id": "rbdtf7g2eey1",
          "kind": "measurement",
          "description": "Scalar measurement with a linear conversion",
          "datatype": "uint8",
          "unit": "%",
          "conversion": {
            "kind": "linear",
            "factor": 0.5
          },
          "limits": {
            "min": 0,
            "max": 100
          },
          "init": 0,
          "volatile": false
        }
      },
      {
        "scope": "output",
        "definition": {
          "name": "ValueB",
          "id": "4kr9hsh0b448",
          "kind": "measurement",
          "description": "Array measurement with four elements",
          "datatype": "uint16",
          "unit": "V",
          "dimensions": [
            4
          ],
          "conversion": {
            "factor": 0.001
          },
          "init": 0,
          "volatile": true
        }
      },
      {
        "scope": "output",
        "definition": {
          "name": "ValueC",
          "id": "3gfbryy2eavj",
          "kind": "measurement",
          "description": "Floating point measurement without a conversion",
          "datatype": "float32",
          "conversion": {
            "kind": "identity"
          },
          "unit": "degC",
          "limits": {
            "min": -50,
            "max": 90
          },
          "volatile": false
        }
      },
      {
        "scope": "output",
        "definition": {
          "name": "FlagA",
          "id": "732wfh15z2kb",
          "kind": "measurement",
          "description": "Boolean measurement",
          "datatype": "boolean",
          "conversion": {
            "kind": "identity"
          },
          "init": false,
          "volatile": false
        }
      },
      {
        "scope": "local",
        "definition": {
          "name": "ValueD",
          "id": "qyjtphycpvba",
          "kind": "measurement",
          "description": "Component local measurement, kept out of the a2l",
          "datatype": "uint16",
          "conversion": {
            "kind": "identity"
          },
          "dimensions": [
            8
          ],
          "a2l": {
            "export": false
          },
          "volatile": false
        }
      }
    ]
  }
}
