/* {{ filename }} - generated from '{{ model.project }}' by {{ model.generator }}. DO NOT EDIT. */
ASAP2_VERSION {{ model.version }}

/begin PROJECT {{ model.project }} "{{ model.description | a2l }}"

  /begin HEADER "{{ model.description | a2l }}"
    PROJECT_NO {{ model.project }}
    VERSION "generated by {{ model.generator }}"
  /end HEADER

  /begin MODULE {{ model.module }} "{{ model.description | a2l }}"

    /begin MOD_COMMON "global variables of {{ model.project }}"
      BYTE_ORDER {{ model.byte_order }}
      ALIGNMENT_BYTE 1
      ALIGNMENT_WORD 2
      ALIGNMENT_LONG 4
      ALIGNMENT_INT64 8
      ALIGNMENT_FLOAT32_IEEE 4
      ALIGNMENT_FLOAT64_IEEE 8
    /end MOD_COMMON
{% if model.system_constants %}

    /begin MOD_PAR "named constants of {{ model.project }}"
{% for constant in model.system_constants %}
      SYSTEM_CONSTANT "{{ constant.name }}" "{{ constant.value }}"
{% endfor %}
    /end MOD_PAR
{% endif %}
{% for layout in model.record_layouts %}

    /begin RECORD_LAYOUT {{ layout.name }}
      {{ layout.entry }}
    /end RECORD_LAYOUT
{% endfor %}
{% for vtab in model.compu_vtabs %}

    /begin COMPU_VTAB {{ vtab.name }} "{{ vtab.description | a2l }}" TAB_VERB {{ vtab.entries | length }}
{% for value, name in vtab.entries %}
      {{ value }} "{{ name | a2l }}"
{% endfor %}
    /end COMPU_VTAB
{% endfor %}
{% for method in model.compu_methods %}

    /begin COMPU_METHOD {{ method.name }} "{{ method.description | a2l }}"
      {{ method.conversion_type }} "{{ method.format }}" "{{ method.unit | a2l }}"
{% if method.coeffs %}
      COEFFS {{ method.coeffs | join(" ") }}
{% endif %}
{% if method.vtab %}
      COMPU_TAB_REF {{ method.vtab }}
{% endif %}
    /end COMPU_METHOD
{% endfor %}
{% for measurement in model.measurements %}

{% if measurement.condition %}
    /* only present in the build when: {{ measurement.condition }} */
{% endif %}
    /begin MEASUREMENT {{ measurement.name }} "{{ measurement.description | a2l }}"
      {{ measurement.datatype }} {{ measurement.compu_method }} 0 0 {{ measurement.lower }} {{ measurement.upper }}
      ECU_ADDRESS {{ measurement.address }}
      SYMBOL_LINK "{{ measurement.name }}" 0
{% if measurement.matrix_dim %}
      MATRIX_DIM {{ measurement.matrix_dim }}
{% endif %}
{% if measurement.format %}
      FORMAT "{{ measurement.format }}"
{% endif %}
{% if measurement.display_identifier %}
      DISPLAY_IDENTIFIER {{ measurement.display_identifier }}
{% endif %}
    /end MEASUREMENT
{% endfor %}
{% for axis in model.axis_pts %}

{% if axis.condition %}
    /* only present in the build when: {{ axis.condition }} */
{% endif %}
    /begin AXIS_PTS {{ axis.name }} "{{ axis.description | a2l }}"
      {{ axis.address }} {{ axis.input_quantity }} {{ axis.deposit }} 0 {{ axis.compu_method }} {{ axis.max_points }} {{ axis.lower }} {{ axis.upper }}
      SYMBOL_LINK "{{ axis.name }}" 0
{% if axis.format %}
      FORMAT "{{ axis.format }}"
{% endif %}
{% if axis.display_identifier %}
      DISPLAY_IDENTIFIER {{ axis.display_identifier }}
{% endif %}
    /end AXIS_PTS
{% endfor %}
{% for characteristic in model.characteristics %}

{% if characteristic.condition %}
    /* only present in the build when: {{ characteristic.condition }} */
{% endif %}
    /begin CHARACTERISTIC {{ characteristic.name }} "{{ characteristic.description | a2l }}"
      {{ characteristic.type }} {{ characteristic.address }} {{ characteristic.deposit }} 0 {{ characteristic.compu_method }} {{ characteristic.lower }} {{ characteristic.upper }}
      SYMBOL_LINK "{{ characteristic.name }}" 0
{% if characteristic.matrix_dim %}
      MATRIX_DIM {{ characteristic.matrix_dim }}
{% endif %}
{% if characteristic.format %}
      FORMAT "{{ characteristic.format }}"
{% endif %}
{% if characteristic.display_identifier %}
      DISPLAY_IDENTIFIER {{ characteristic.display_identifier }}
{% endif %}
{% for descr in characteristic.axis_descrs %}
      /begin AXIS_DESCR
        {{ descr.attribute }} {{ descr.input_quantity }} {{ descr.compu_method }} {{ descr.max_points }} {{ descr.lower }} {{ descr.upper }}
        AXIS_PTS_REF {{ descr.axis_ref }}
      /end AXIS_DESCR
{% endfor %}
    /end CHARACTERISTIC
{% endfor %}
{% for group in model.groups %}

    /begin GROUP {{ group.name }} "{{ group.description | a2l }}"
      ROOT
{% if group.measurements %}
      /begin REF_MEASUREMENT
{% for name in group.measurements %}
        {{ name }}
{% endfor %}
      /end REF_MEASUREMENT
{% endif %}
{% if group.characteristics %}
      /begin REF_CHARACTERISTIC
{% for name in group.characteristics %}
        {{ name }}
{% endfor %}
      /end REF_CHARACTERISTIC
{% endif %}
    /end GROUP
{% endfor %}

  /end MODULE

/end PROJECT
