{
  "$schema": "../../../schemas/ddd_component.schema.json",
  "component": {
    "name": "UserInterface",
    "description": "Reads the values of the other components and drives the display",
    "declarations": [
      {
        "scope": "input",
        "definition": {
          "name": "ValueE",
          "kind": "measurement",
          "description": "Measurement used as the input quantity of AxisA",
          "datatype": "uint16",
          "unit": "Hz",
          "conversion": { "kind": "linear", "factor": 0.25 },
          "limits": { "min": 0, "max": 8000 },
          "volatile": true
        }
      },
      {
        "scope": "input",
        "definition": {
          "name": "ValueF",
          "kind": "measurement",
          "description": "Signed measurement with a fixed point conversion",
          "datatype": "sint16",
          "unit": "degC",
          "conversion": { "kind": "linear", "factor": 0.1 },
          "limits": { "min": -40, "max": 150 }
        }
      },
      {
        "scope": "input",
        "definition": {
          "name": "ValueC",
          "kind": "measurement",
          "description": "Floating point measurement without a conversion",
          "datatype": "float32",
          "unit": "degC",
          "limits": {
            "min": -50,
            "max": 90
          }
        }
      },
      {
        "scope": "input",
        "definition": {
          "name": "StateA",
          "kind": "measurement",
          "description": "Measurement with a verbal conversion table",
          "datatype": "uint8",
          "conversion": {
            "kind": "enum",
            "name": "StateA_t",
            "enumerators": [
              { "name": "STATE_OFF", "value": 0, "description": "powered but not started" },
              { "name": "STATE_INIT", "value": 1 },
              { "name": "STATE_ACTIVE", "value": 2 },
              { "name": "STATE_DEGRADED", "value": 3 },
              { "name": "STATE_FAULT", "value": 15 }
            ]
          }
        }
      },
      {
        "scope": "input",
        "definition": {
          "name": "ValueB",
          "kind": "measurement",
          "description": "Array measurement with four elements",
          "datatype": "uint16",
          "unit": "V",
          "dimensions": [4],
          "conversion": { "factor": 0.001 },
          "volatile": true
        }
      },
      {
        "scope": "input",
        "condition": "defined(FEATURE_X)",
        "definition": {
          "name": "ValueG",
          "kind": "measurement",
          "description": "Measurement that only exists when FEATURE_X is defined",
          "datatype": "uint16",
          "unit": "V",
          "conversion": { "factor": 0.001 },
          "limits": { "min": 0, "max": 5 }
        }
      },
      {
        "scope": "input",
        "definition": {
          "name": "ValueJ",
          "kind": "measurement",
          "description": "Counter written by the event logger",
          "datatype": "uint8"
        }
      },
      {
        "scope": "output",
        "definition": {
          "name": "ValueI",
          "kind": "measurement",
          "description": "Bit coded measurement written by the user interface",
          "datatype": "uint32",
          "init": 0
        }
      },
      {
        "scope": "input",
        "definition": {
          "kind": "axis",
          "name": "AxisA",
          "description": "Shared axis indexed by ValueE",
          "datatype": "uint16",
          "conversion": { "factor": 0.25 },
          "limits": { "min": 0, "max": 8000 },
          "size": 6,
          "input": "ValueE",
          "unit": "Hz"
        }
      },
      {
        "scope": "local",
        "definition": {
          "kind": "curve",
          "name": "CurveB",
          "description": "Second calibratable curve over the same shared axis",
          "datatype": "uint8",
          "unit": "%",
          "conversion": { "factor": 0.5 },
          "axis": "AxisA",
          "init": 200
        }
      },
      {
        "scope": "local",
        "definition": {
          "kind": "value_block",
          "name": "BlockA",
          "description": "Calibratable array of constants",
          "datatype": "uint8",
          "dimensions": [8],
          "init": [0, 12, 28, 52, 84, 124, 180, 255]
        }
      }
    ]
  }
}
